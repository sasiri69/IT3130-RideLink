              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceArea\": \"Malabe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/service-area",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "{{driverId}}", "service-area"]
            }
          }
        },
        {
          "name": "DELETE Remove Vehicle (204 No Content)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/vehicle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "{{driverId}}", "vehicle"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Dispatch Queries (For Member 3 Ride Service)",
      "item": [
        {
          "name": "GET Available Drivers (Filtered by Area & Vehicle)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/available?serviceArea=Colombo&vehicleType=CAR",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "available"],
              "query": [
                {
                  "key": "serviceArea",
                  "value": "Colombo"
                },
                {
                  "key": "vehicleType",
                  "value": "CAR"
                }
              ]
            }
          }
        },
        {
          "name": "GET Nearby Drivers (Haversine Proximity Search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/nearby?latitude=6.9271&longitude=79.8612&radiusKm=10.0&vehicleType=CAR",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "nearby"],
              "query": [
                {
                  "key": "latitude",
                  "value": "6.9271"
                },
                {
                  "key": "longitude",
                  "value": "79.8612"
                },
                {
                  "key": "radiusKm",
                  "value": "10.0"
                },
                {
                  "key": "vehicleType",
                  "value": "CAR"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Negative Scenarios (Workflow 7)",
      "item": [
        {
          "name": "Negative 1: Non-Existent Account ID (Expect 404/400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"non-existent-user-id\",\n  \"licenseNumber\": \"B9999999\",\n  \"serviceArea\": \"Colombo\",\n  \"vehicle\": {\n    \"make\": \"Toyota\",\n    \"model\": \"Corolla\",\n    \"year\": 2020,\n    \"licensePlate\": \"WP-CAE-1111\",\n    \"color\": \"White\",\n    \"vehicleType\": \"CAR\",\n    \"seatingCapacity\": 4\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers"]
            }
          }
        },
        {
          "name": "Negative 2: Duplicate Driver Registration (Expect 409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"{{driverId}}\",\n  \"licenseNumber\": \"B7894561\",\n  \"serviceArea\": \"Colombo\",\n  \"vehicle\": {\n    \"make\": \"Toyota\",\n    \"model\": \"Prius\",\n    \"year\": 2022,\n    \"licensePlate\": \"CAB-5566\",\n    \"color\": \"Silver\",\n    \"vehicleType\": \"CAR\",\n    \"seatingCapacity\": 4\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers"]
            }
          }
        },
        {
          "name": "Negative 3: Validation Error - Missing Fields (Expect 400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"\",\n  \"serviceArea\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers"]
            }
          }
        },
        {
          "name": "Negative 4: Non-Existent Driver ID (Expect 404 Not Found)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/unknown-driver-id-999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "unknown-driver-id-999"]
            }
          }
        },
        {
          "name": "Negative 5: Delete Another Driver's Vehicle (Expect 403 Forbidden)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/another-driver-id-999/vehicle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "another-driver-id-999", "vehicle"]
            }
          }
        },
        {
          "name": "Negative 6: Delete Vehicle While Driver Is Busy (Expect 400 Bad Request)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/vehicle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "{{driverId}}", "vehicle"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Admin Management",
      "item": [
        {
          "name": "GET All Drivers (Admin Filter)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers?status=AVAILABLE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers"],
              "query": [
                {
                  "key": "status",
                  "value": "AVAILABLE"
                }
              ]
            }
          }
        },
        {
          "name": "PATCH Admin Status Update (e.g. SUSPEND)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SUSPENDED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/admin-status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "{{driverId}}", "admin-status"]
            }
          }
        }
      ]
    }

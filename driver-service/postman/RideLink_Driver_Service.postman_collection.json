{
  "info": {
    "name": "RideLink – Driver & Vehicle Service (Member 2)",
    "description": "Postman API Collection for Member 2 (IT24100687).\nComplies with Lecture 07 (REST Fundamentals) and Lecture 08 (Communication Interfaces II).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Driver Registration (Workflow 2 & Member 1 Connection)",
      "item": [
        {
          "name": "POST Register Driver Profile & Vehicle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"{{driverId}}\",\n  \"licenseNumber\": \"B7894561\",\n  \"serviceArea\": \"Colombo\",\n  \"vehicle\": {\n    \"make\": \"Toyota\",\n    \"model\": \"Prius\",\n    \"year\": 2022,\n    \"licensePlate\": \"CAB-5566\",\n    \"color\": \"Silver Metallic\",\n    \"vehicleType\": \"CAR\",\n    \"seatingCapacity\": 4\n  },\n  \"initialLocation\": {\n    \"latitude\": 6.9271,\n    \"longitude\": 79.8612,\n    \"addressName\": \"Colombo Fort Station\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers"]
            }
          }
        },
        {
          "name": "GET Own Operational Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "me"]
            }
          }
        },
        {
          "name": "GET Driver by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "{{driverId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Operational Lifecycle & Availability",
      "item": [
        {
          "name": "PATCH Declare Availability -> AVAILABLE",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"AVAILABLE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/availability",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "{{driverId}}", "availability"]
            }
          }
        },
        {
          "name": "PATCH Declare Availability -> OFFLINE",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"OFFLINE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/availability",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "{{driverId}}", "availability"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Location & Vehicle Management",
      "item": [
        {
          "name": "PATCH Update Simulated GPS Location",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 6.9147,\n  \"longitude\": 79.9733,\n  \"addressName\": \"Malabe SLIIT Junction\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/location",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "{{driverId}}", "location"]
            }
          }
        },
        {
          "name": "POST Add Vehicle to Driver (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Honda\",\n  \"model\": \"Grace Hybrid\",\n  \"year\": 2023,\n  \"licensePlate\": \"WP-CAD-8899\",\n  \"color\": \"Pearl Black\",\n  \"vehicleType\": \"CAR\",\n  \"seatingCapacity\": 4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/vehicle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "{{driverId}}", "vehicle"]
            }
          }
        },
        {
          "name": "GET Driver Vehicle Details (200 OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/vehicle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "{{driverId}}", "vehicle"]
            }
          }
        },
        {
          "name": "PUT Replace Vehicle Details (Idempotent)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{driverToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Honda\",\n  \"model\": \"Grace Hybrid\",\n  \"year\": 2023,\n  \"licensePlate\": \"WP-CAD-8899\",\n  \"color\": \"Pearl Black\",\n  \"vehicleType\": \"CAR\",\n  \"seatingCapacity\": 4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}/vehicle",
              "host": ["{{baseUrl}}"],
              "path": ["api", "drivers", "{{driverId}}", "vehicle"]
            }
          }
        },
        {
          "name": "PATCH Update Service Area",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",

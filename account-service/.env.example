# ============================================================
# RideLink Account Service - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git!
# ============================================================

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ridelink_account_db?retryWrites=true&w=majority

# JWT signing secret (minimum 32-char hex string)
JWT_SECRET=your_jwt_secret_key_here_minimum_32_chars

# Token expiry in milliseconds (defaults apply if omitted)
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Server port (default 8081)
SERVER_PORT=8081

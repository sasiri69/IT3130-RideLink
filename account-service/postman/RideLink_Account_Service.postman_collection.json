                  "pm.test('Role is DRIVER', () => pm.expect(pm.response.json().role).to.eql('DRIVER'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nimal\",\n  \"lastName\": \"Silva\",\n  \"email\": \"nimal.silva@test.com\",\n  \"password\": \"password123\",\n  \"phone\": \"0771234567\",\n  \"role\": \"DRIVER\"\n}"
